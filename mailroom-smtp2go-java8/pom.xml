<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.primelogiclab.mailroom</groupId>
        <artifactId>mailroom-smtp2go-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mailroom-smtp2go-java8</artifactId>
    <name>mailroom-smtp2go-java8</name>
    <description>Unofficial SMTP2GO API transport for mailroom. Java 8 set.</description>

    <properties>
        <module.name>io.primelogiclab.mailroom.smtp2go</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.primelogiclab.mailroom</groupId>
            <artifactId>mailroom-core-java8</artifactId>
        </dependency>
        <dependency>
            <groupId>io.primelogiclab.mailroom</groupId>
            <artifactId>mailroom-http-java8</artifactId>
        </dependency>
        <dependency>
            <groupId>io.primelogiclab.mailroom</groupId>
            <artifactId>mailroom-tck-java8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Adds shared-tests, the tests and fixtures this module shares with its Java 21 twin. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
